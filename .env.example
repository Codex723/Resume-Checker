# ─────────────────────────────────────────────────────────
# SERVER (server/index.js) — copy this file to ".env"
# ─────────────────────────────────────────────────────────

# Required. Free, no credit card needed. Get one at:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Port the local analysis API listens on.
PORT=3001

# Optional. Which origin is allowed to call the API (your frontend's URL).
# Defaults to http://localhost:8080 (the Vite dev server) if unset.
CLIENT_ORIGIN=http://localhost:8080

# Optional. Set to "false" to skip live Google Search research and save
# quota. On by default: each analysis researches your specific profession
# via search before scoring, which uses a smaller/separate free-tier quota
# than plain analysis. It fails soft and auto-retries brief rate limits,
# but if you're hitting persistent 429s, set this to "false".
GROUNDED_RESEARCH=true

# ─────────────────────────────────────────────────────────
# FRONTEND (Vite) — only needed if the API is NOT on the same
# origin (e.g. you deploy the backend separately, like on Render
# or Railway, while the frontend is on Vercel/Netlify).
# Vite only exposes variables prefixed with VITE_.
# ─────────────────────────────────────────────────────────

# Leave empty during local dev (the Vite proxy in vite.config.ts
# forwards /api to localhost:3001 for you). In production, set this
# to your deployed backend's URL, e.g. https://your-api.onrender.com
VITE_API_URL=
